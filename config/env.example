# ==============================================================================
# Zitadel on AWS Lightsail - Environment Variables (.env)
# All variables required by zitadel-compose.yml are defined below
# ==============================================================================

# 1. Domain & Zitadel Version
ZITADEL_DOMAIN=auth.example.com
ZITADEL_VERSION=v2.67.0

# 2. Encryption Keys (Must be exactly 32 alphanumeric characters)
# Generate via: openssl rand -base64 32 | tr -dc 'A-Za-z0-9' | head -c 32; echo
ZITADEL_MASTERKEY=replace_with_32_char_masterkey
LOGIN_SESSION_COOKIE_SECRET=replace_with_32_char_cookie_secret

# 3. Database Connection (External PostgreSQL)
ZITADEL_DATABASE_POSTGRES_DSN=postgres://zitadel:strong_password@your-db-host:5432/zitadel?sslmode=require

# 4. Initial Organization Admin Account (Created on first boot)
ZITADEL_FIRSTINSTANCE_ORG_HUMAN_USERNAME=admin@example.com
ZITADEL_FIRSTINSTANCE_ORG_HUMAN_EMAIL_ADDRESS=admin@example.com
ZITADEL_FIRSTINSTANCE_ORG_HUMAN_PASSWORD=ChangeMeImmediately123!

# 5. Cloudflare DNS-01 ACME Challenge & SSL Certificate Notifications
CF_DNS_API_TOKEN=your_cloudflare_dns_api_token
ACME_EMAIL=admin@example.com
